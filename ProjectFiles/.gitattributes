# Text files: normalize line endings on commit, let Git auto-detect binaries.
* text=auto

# ---------------------------------------------------------------------------
# Explicit text types (never let auto-detection get these wrong)
# ---------------------------------------------------------------------------
*.uproject   text eol=lf
*.uplugin    text eol=lf
*.ini        text
*.cs         text
*.cpp        text
*.h          text
*.md         text
*.json       text
*.py         text
*.usf        text
*.ush        text
*.xml        text

# ---------------------------------------------------------------------------
# Git LFS — Unreal binary assets
# Anything below is stored as a pointer; the bytes live in LFS, not in the
# Git history. Add a pattern here BEFORE committing a new binary type.
# ---------------------------------------------------------------------------

# Unreal packages
*.uasset  filter=lfs diff=lfs merge=lfs -text
*.umap    filter=lfs diff=lfs merge=lfs -text
*.upk     filter=lfs diff=lfs merge=lfs -text
*.udk     filter=lfs diff=lfs merge=lfs -text
*.ubulk   filter=lfs diff=lfs merge=lfs -text
*.uexp    filter=lfs diff=lfs merge=lfs -text
*.pak     filter=lfs diff=lfs merge=lfs -text

# Images / textures
